# ---------------------------------------------------------------------------
# Copy to .env before running: cp .env.example .env
# ---------------------------------------------------------------------------

OLLAMA_URL=http://ollama:11434
LLM_MODEL=qwen2.5:0.5b
# Alternatives approved for this team: llama3.1:8b, deepseek-r1:8b
LLM_TIMEOUT=120

# --- Shared AI services (Release 1: run natively on the host, NOT in ------
# --- Docker Compose - see scripts/run-ai-services.sh. Containers reach ----
# --- them through the host.docker.internal alias below. -------------------
AI_MODE_URL=http://host.docker.internal:7001
AI_MODE_MAX_ADAPT_ATTEMPTS=2
MCP_SERVER_URL=http://host.docker.internal:7002
RAG_SERVER_URL=http://host.docker.internal:7003
MCP_TIMEOUT=15
RAG_TIMEOUT=120

# Keep these true for local Release 1 use. Student 3 CI sets them false and
# uses mocked clients so no external native service is required there.
AI_MODE_ENABLED=true
MCP_ENABLED=true
RAG_ENABLED=true

# When running a service natively on the host yourself (not in a container),
# use localhost instead, e.g.: AI_MODE_URL=http://localhost:7001
