# Copy to .env before running: cp .env.example .env

OLLAMA_URL=http://ollama:11434
LLM_MODEL=qwen2.5:0.5b
# Alternatives approved for this team: llama3.1:8b, deepseek-r1:8b
LLM_TIMEOUT=120

# Shared AI services run on the host. Containers reach them through
# host.docker.internal; see scripts/run-ai-services.sh.
AI_MODE_URL=http://host.docker.internal:7001
AI_MODE_MAX_ADAPT_ATTEMPTS=2
MCP_SERVER_URL=http://host.docker.internal:7002
RAG_SERVER_URL=http://host.docker.internal:7003
MCP_TIMEOUT=15
RAG_TIMEOUT=120

# Shared native Multi-Agent workflow service (separate Planner/Worker/Reviewer calls).
MULTI_AGENT_URL=http://host.docker.internal:7004
MULTI_AGENT_OLLAMA_URL=http://127.0.0.1:11434
MULTI_AGENT_ENABLED=true
MULTI_AGENT_TIMEOUT=180
MULTI_AGENT_STAGE_TIMEOUT=120
MULTI_AGENT_MAX_REVISIONS=1
MULTI_AGENT_NUM_PREDICT=1024
# Lecture role assignment; the Worker keeps the configured shared Qwen model.
MULTI_AGENT_PLANNER_MODEL=llama3.1:8b
MULTI_AGENT_WORKER_MODEL=qwen2.5:3b
MULTI_AGENT_REVIEWER_MODEL=deepseek-r1:8b

# Keep these true for local Release 1 use. Student 3 CI sets them false and
# uses mocked clients so no external native service is required there.
AI_MODE_ENABLED=true
MCP_ENABLED=true
RAG_ENABLED=true

# When running a service natively on the host yourself (not in a container),
# use localhost instead, e.g.: AI_MODE_URL=http://localhost:7001
